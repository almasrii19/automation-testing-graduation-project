<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Automation Suite" parallel="tests" thread-count="2" verbose="1">
    <parameter name="threadCount" value="2"/>
    <listeners>
        <listener class-name="com.orangehrm.listeners.TestListener"/>
    </listeners>

    <test name="Authentication Tests">
        <classes>
            <class name="com.orangehrm.tests.LoginTests"/>
        </classes>
    </test>

    <test name="PIM Employee Tests">
        <classes>
            <class name="com.orangehrm.tests.EmployeeManagementTests"/>
        </classes>
    </test>

    <test name="Admin and Navigation Tests">
        <classes>
            <class name="com.orangehrm.tests.AdminNavigationTests"/>
        </classes>
    </test>
</suite>
